diff --git a/src/controllers/well-known.js b/src/controllers/well-known.js
new file mode 100644
index 0000000..33e5369
--- /dev/null
+++ b/src/controllers/well-known.js
@@ -0,0 +1,57 @@
+'use strict';
+
+const nconf = require('nconf');
+
+const user = require('../user');
+const privileges = require('../privileges');
+const controllers = {
+	helpers: require('./helpers'),
+};
+
+// Handles GET /.well-known/webfinger (RFC 7033).
+// Validates the `resource` query param, gates on view:users privilege,
+// resolves the username slug to a UID, and returns a WebFinger JSON payload.
+module.exports.webfinger = async function (req, res) {
+	const { resource } = req.query;
+
+	if (!resource) {
+		return res.status(400).json({ error: 'missing resource parameter' });
+	}
+
+	if (!resource.startsWith('acct:')) {
+		return res.status(400).json({ error: 'resource must use acct: URI scheme' });
+	}
+
+	const hostname = nconf.get('url_parsed').hostname;
+	if (!resource.endsWith(`@${hostname}`)) {
+		return res.status(400).json({ error: 'resource hostname mismatch' });
+	}
+
+	const canView = await privileges.global.can('view:users', req.uid || 0);
+	if (!canView) {
+		return controllers.helpers.notAllowed(req, res);
+	}
+
+	const slug = resource.slice('acct:'.length, resource.lastIndexOf('@'));
+	const uid = await user.getUidByUserslug(slug);
+	if (!uid) {
+		return res.status(404).json({ error: 'user not found' });
+	}
+
+	const baseUrl = nconf.get('url');
+	const subject = resource;
+	const uidUrl = `${baseUrl}/uid/${uid}`;
+	const slugUrl = `${baseUrl}/user/${slug}`;
+
+	return res.json({
+		subject,
+		aliases: [uidUrl, slugUrl],
+		links: [
+			{
+				rel: 'http://webfinger.net/rel/profile-page',
+				type: 'text/html',
+				href: `${baseUrl}/user/${slug}`,
+			},
+		],
+	});
+};
