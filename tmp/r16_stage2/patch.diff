index 000000000..7242157d1
--- /dev/null
+++ b/openlibrary/solr/utils.py
@@ -0,0 +1,263 @@
+"""openlibrary.solr.utils
+
+Canonical Solr configuration/shared state/helpers.
+
+This module is the single owner of:
+- Lazy runtime config loading (compatible with update_work.py semantics)
+- Cached Solr base URL and solr_next flag
+- SolrUpdateState request container + serialization helpers
+- Solr update helpers (retries + tolerant-chain error parsing)
+
+Other modules may provide backwards-compatible shims which delegate to this
+module to avoid split global state.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+import httpx
+
+from openlibrary import config
+
+logger = logging.getLogger(__name__)
+
+# ---------------------------------------------------------------------------
+# Lazy-config-load + module-global caching semantics (canonical owner)
+# ---------------------------------------------------------------------------
+
+_config_loaded: bool = False
+_solr_base_url: Optional[str] = None
+_solr_next: Optional[bool] = None
+
+
+def load_config(c_config: str = "conf/openlibrary.yml") -> None:
+    """Loads the Open Library runtime configuration if it has not been loaded yet.
+
+    Mirrors the existing lazy-load behavior used by update_work.py: only loads
+    config once and relies on openlibrary.config.runtime_config as the store.
+    """
+    global _config_loaded
+    if _config_loaded:
+        return
+    # openlibrary.config.load_config populates config.runtime_config
+    config.load_config(c_config)
+    _config_loaded = True
+
+
+def get_solr_base_url() -> str:
+    """Returns the Solr base URL from the loaded configuration, cached."""
+    global _solr_base_url
+    if _solr_base_url is not None:
+        return _solr_base_url
+
+    load_config()
+    try:
+        _solr_base_url = config.runtime_config["plugin_worksearch"]["solr_base_url"]
+    except Exception as e:  # pragma: no cover
+        # Keep error message helpful; callers expect a URL string.
+        raise KeyError("Missing config.runtime_config['plugin_worksearch']['solr_base_url']") from e
+    return _solr_base_url
+
+
+def set_solr_base_url(solr_url: str) -> None:
+    """Sets the Solr base URL in the module's internal state."""
+    global _solr_base_url
+    _solr_base_url = solr_url
+
+
+def get_solr_next() -> bool:
+    """Returns whether the application should use the next Solr schema version."""
+    global _solr_next
+    if _solr_next is not None:
+        return _solr_next
+
+    load_config()
+    _solr_next = bool(config.runtime_config.get("plugin_worksearch", {}).get("solr_next", False))
+    return _solr_next
+
+
+def set_solr_next(val: bool) -> None:
+    """Sets the internal state to indicate whether to use the next Solr schema version."""
+    global _solr_next
+    _solr_next = bool(val)
+
+
+# ---------------------------------------------------------------------------
+# Solr update state container
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class SolrUpdateState:
+    """Dataclass to represent a Solr update request.
+
+    Attributes:
+        keys: Optional bookkeeping for callers (e.g. update_work).
+        adds: Documents to add (each dict should contain an 'key' id field unless
+              skip_id_check=True at send time).
+        deletes: Keys/ids to delete.
+        commit: Whether to request a commit.
+    """
+
+    keys: dict[str, Any] = field(default_factory=dict)
+    adds: list[dict[str, Any]] = field(default_factory=list)
+    deletes: list[str] = field(default_factory=list)
+    commit: bool = False
+
+    def has_changes(self) -> bool:
+        """Returns True if the SolrUpdateState contains any add or delete operations."""
+        return bool(self.adds or self.deletes)
+
+    def clear_requests(self) -> None:
+        """Clears the add and delete operations from the SolrUpdateState."""
+        self.adds.clear()
+        self.deletes.clear()
+
+    def merge(self, other: "SolrUpdateState") -> None:
+        """Merge another state into this one (in-place)."""
+        if other.keys:
+            self.keys.update(other.keys)
+        if other.adds:
+            self.adds.extend(other.adds)
+        if other.deletes:
+            self.deletes.extend(other.deletes)
+        self.commit = self.commit or other.commit
+
+    def to_solr_requests_json(self, indent: Optional[str] = None, sep: str = ",") -> str:
+        """Serializes the SolrUpdateState to a JSON string for Solr requests.
+
+        Note: Historically, update_work built JSON via concatenation; this
+        implementation generates canonical JSON. It produces a list of commands,
+        which Solr's update handler accepts:
+          [{"add": {"doc": {...}}}, {"delete": {"id": "..."}}]
+        """
+        commands: list[dict[str, Any]] = []
+
+        for doc in self.adds:
+            commands.append({"add": {"doc": doc}})
+
+        for key in self.deletes:
+            commands.append({"delete": {"id": key}})
+
+        if self.commit:
+            commands.append({"commit": {}})
+
+        # Keep signature compatible: indent is Optional[str] in existing code.
+        json_indent = None if indent is None else 2
+        return json.dumps(commands, indent=json_indent, separators=(sep, ":"))
+
+
+# ---------------------------------------------------------------------------
+# HTTP helpers (retries + tolerant-chain parsing/logging)
+# ---------------------------------------------------------------------------
+
+
+def _extract_solr_400_errors(payload: Any) -> tuple[list[str], Optional[str]]:
+    """Extract tolerant-chain error details from a Solr 400 response payload."""
+    errors: list[str] = []
+    global_msg: Optional[str] = None
+
+    if isinstance(payload, dict):
+        # tolerant-chain often reports per-document failures here:
+        rh = payload.get("responseHeader")
+        if isinstance(rh, dict):
+            rh_errors = rh.get("errors")
+            if isinstance(rh_errors, list):
+                for e in rh_errors:
+                    try:
+                        errors.append(json.dumps(e, ensure_ascii=False))
+                    except Exception:
+                        errors.append(str(e))
+
+        err = payload.get("error")
+        if isinstance(err, dict):
+            msg = err.get("msg")
+            if isinstance(msg, str):
+                global_msg = msg
+
+    return errors, global_msg
+
+
+def solr_update(
+    update_request: SolrUpdateState,
+    skip_id_check: bool = False,
+    solr_base_url: Optional[str] = None,
+) -> None:
+    """Sends a batch update request to Solr with retries and tolerant-chain parsing/logging."""
+    if solr_base_url is None:
+        solr_base_url = get_solr_base_url()
+
+    url = solr_base_url.rstrip("/") + "/update"
+    params: dict[str, Any] = {"update.chain": "tolerant-chain"}
+    if skip_id_check:
+        params["overwrite"] = "false"
+
+    content = update_request.to_solr_requests_json()
+
+    max_retries = 5
+    delay = 0.5
+    last_exc: Optional[BaseException] = None
+
+    for attempt in range(max_retries):
+        try:
+            resp = httpx.post(
+                url,
+                params=params,
+                content=content,
+                headers={"Content-Type": "application/json"},
+                timeout=60.0,
+            )
+
+            # Handle tolerant-chain style HTTP 400 responses gracefully by logging
+            # per-doc errors and not necessarily raising, matching existing behavior.
+            if resp.status_code == 400:
+                payload: Any
+                try:
+                    payload = resp.json()
+                except Exception:
+                    payload = None
+
+                per_doc_errors, global_msg = _extract_solr_400_errors(payload)
+
+                if per_doc_errors:
+                    for e in per_doc_errors:
+                        logger.error("Solr tolerant-chain error: %s", e)
+                    # Do not raise; tolerant-chain returns 400 when some docs fail.
+                    return
+
+                if global_msg:
+                    logger.error("Solr error: %s", global_msg)
+                    return
+
+                # Unknown 400 shape: raise as before.
+                resp.raise_for_status()
+                return
+
+            resp.raise_for_status()
+            return
+
+        except (httpx.HTTPStatusError, httpx.TimeoutException, httpx.HTTPError) as e:
+            last_exc = e
+            if attempt >= max_retries - 1:
+                raise
+            time.sleep(delay)
+            delay *= 2
+
+    if last_exc is not None:  # pragma: no cover
+        raise last_exc
+
+
+async def solr_insert_documents(
+    documents: list[dict],
+    solr_base_url: Optional[str] = None,
+    skip_id_check: bool = False,
+) -> None:
+    """Asynchronously inserts a list of documents into Solr."""
+    state = SolrUpdateState(adds=documents, deletes=[], commit=False)
+    # solr_update is sync; keep async signature for compatibility.
+    solr_update(state, skip_id_check=skip_id_check, solr_base_url=solr_base_url)
